{
  "name": "brainzippy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:launch": "BZ_E2E_FLAGS=launch playwright test e2e/launch.spec.ts e2e/full-round.spec.ts --project=desktop --project=phone",
    "db:migrate:local": "wrangler d1 migrations apply brainzippy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply brainzippy-db --remote",
    "gen:sfx": "python3 scripts/gen_sfx.py",
    "gen:voice": "python3 scripts/gen_voice.py",
    "deploy:preview": "npm run build && wrangler versions upload",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
