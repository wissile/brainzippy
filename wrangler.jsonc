{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainzippy",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Invocation logs would retain request URLs (incl. guest ids) — keep them off for a children's product.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "preview_urls": false,
  // UTC. Each cron maps to named jobs in worker/jobs/index.ts (CRON_JOBS). Free plan allows 5 Cron Triggers per account; this uses 3.
  // 03:17 retention purge · every 10 min in hour 23 daily parent digest · hourly at :00 daily-reminder push.
  "triggers": { "crons": ["17 3 * * *", "*/10 23 * * *", "0 * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainzippy-db",
      // Placeholder for LOCAL development only (`--local` D1 state). Staging and production have no database_id and are
      // provisioned by `wrangler deploy`; a deploy that fell back to this top level would fail on this id (safe).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (wrangler secret put / .dev.vars): RESEND_API_KEY, SIGNING_SECRET, VAPID_PRIVATE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
  // Billing vars: STRIPE_PRICE_ID (price_… for $6.99/month; empty = billing off), optional STRIPE_AUTOMATIC_TAX ("1"), STRIPE_API_BASE (tests only). See docs/BILLING.md.
  // Optional vars: EMAIL_FROM, APP_ORIGIN, DIGEST_BATCH. VAPID_PUBLIC_KEY from `node scripts/gen-vapid.mjs` (empty = reminders off).
  // Top level is production-safe on purpose: if a deploy ever falls back to the top level, nothing development-only
  // turns on. Local development sets APP_ENV=development in the gitignored .dev.vars (copy .dev.vars.example), and
  // the Worker additionally requires a localhost request before any development behaviour runs (worker/lib/config.ts).
  // Feature flags (D-030: guest-only production launch until legal review). Each is on only when exactly "true".
  //   ACCOUNTS_ENABLED: parent sign-in/sign-up, children, sync, dashboard, daily digest email.
  //   BILLING_ENABLED:  checkout, portal, codes, webhook and the day-15 trial clock (needs accounts).
  //   FRIENDS_ENABLED:  friends, leaderboard and challenges (needs accounts; a lawyer must decide on verifiable
  //                     parental consent first, docs/legal/COPPA_CHECKLIST.md).
  // "false" here and in production; "true" in staging and in .dev.vars. How to turn each on: docs/DEPLOY.md.
  "vars": {
    "APP_ENV": "production",
    "ACCOUNTS_ENABLED": "false",
    "BILLING_ENABLED": "false",
    "FRIENDS_ENABLED": "false",
    "EMAIL_FROM": "BrainZippy <hello@brainzippy.com>",
    "STRIPE_PRICE_ID": "",
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "mailto:hello@brainzippy.com"
  },
  "env": {
    "staging": {
      "name": "brainzippy-staging",
      "vars": {
        "APP_ENV": "staging",
        "ACCOUNTS_ENABLED": "true",
        "BILLING_ENABLED": "true",
        "FRIENDS_ENABLED": "true",
        "EMAIL_FROM": "BrainZippy <hello@brainzippy.com>",
        "STRIPE_PRICE_ID": "",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "mailto:hello@brainzippy.com"
      },
      // Staging is served on <name>.<account>.workers.dev; set APP_ORIGIN to that URL once known (docs/DEPLOY.md).
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          // No database_id: `wrangler deploy` provisions or reuses the database by this name (docs/DEPLOY.md).
          "database_name": "brainzippy-db-staging",
          "migrations_dir": "migrations"
        }
      ]
    },
    // Production: deployed ONLY by the manual "Deploy → production" workflow behind the owner-approved
    // GitHub environment. Requires brainzippy.com to be an active Cloudflare zone (custom domain is created on deploy).
    "production": {
      "name": "brainzippy",
      // www → apex is a Cloudflare Redirect Rule (docs/DEPLOY.md), so search engines see one canonical host.
      "routes": [{ "pattern": "brainzippy.com", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        "ACCOUNTS_ENABLED": "false",
        "BILLING_ENABLED": "false",
        "FRIENDS_ENABLED": "false",
        "APP_ORIGIN": "https://brainzippy.com",
        "EMAIL_FROM": "BrainZippy <hello@brainzippy.com>",
        "STRIPE_PRICE_ID": "",
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "mailto:hello@brainzippy.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          // No database_id: the first `wrangler deploy` creates "brainzippy-db"; later deploys find it by name (docs/DEPLOY.md).
          "database_name": "brainzippy-db",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
