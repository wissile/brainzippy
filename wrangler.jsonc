{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainzippy",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Invocation logs would retain request URLs (incl. guest ids) — keep them off for a children's product.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "preview_urls": false,
  // 03:17 UTC daily retention purge; hourly at :00 = daily-reminder push job (worker/routes/push.ts)
  "triggers": { "crons": ["17 3 * * *", "0 * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainzippy-db",
      // Placeholder for local dev. Replace with the real ID from `wrangler d1 create brainzippy-db` before any remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // VAPID_PUBLIC_KEY: from `node scripts/gen-vapid.mjs` (empty = reminders off). VAPID_PRIVATE_KEY is a secret (wrangler secret put / .dev.vars).
  "vars": { "APP_ENV": "development", "VAPID_PUBLIC_KEY": "", "VAPID_SUBJECT": "mailto:hello@brainzippy.com" },
  "env": {
    "staging": {
      "name": "brainzippy-staging",
      "vars": { "APP_ENV": "staging", "VAPID_PUBLIC_KEY": "", "VAPID_SUBJECT": "mailto:hello@brainzippy.com" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brainzippy-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
