{
  "_note": "Hoot's Rhyme Lanterns. rl.w.* = one whole-word clip per picture; rl.slow.* = the same word rendered slowly (speed is read by scripts/gen_voice.py) for the hint where Hoot says both words slowly.",
  "lines": {
    "rl.intro": {
      "text": "Hoo-hoo! Will you help me light my rhyme lanterns?"
    },
    "rl.back": {
      "text": "Welcome back! More lanterns are waiting for rhymes."
    },
    "rl.story.1": {
      "text": "Deep in the forest, the sun is going down."
    },
    "rl.story.2": {
      "text": "Tonight is Hoot's lantern party, but every lantern is dark!"
    },
    "rl.story.3": {
      "text": "Hoot's lanterns only glow when rhyming words meet. Cat, hat!"
    },
    "rl.story.4": {
      "text": "Hoo-hoo! Help me find words that rhyme, so the party can start!"
    },
    "rl.mid.1": {
      "text": "Look! The forest path is starting to glow."
    },
    "rl.mid.2": {
      "text": "Halfway there! The fireflies are coming to see."
    },
    "rl.mid.3": {
      "text": "Just a few more lanterns to light!"
    },
    "rl.story.end1": {
      "text": "Every lantern is glowing! The forest party can begin!"
    },
    "rl.story.end2": {
      "text": "You listened to the ends of the words and found the rhymes."
    },
    "rl.story.end3": {
      "text": "You earned a Brain Spark! Next time, the rhymes get trickier."
    },
    "rl.ask.yesno": {
      "text": "Do they rhyme? Bright lanterns mean yes. A sleepy lantern means no."
    },
    "rl.ask.pick": {
      "text": "Which picture rhymes with Hoot's lantern? Listen!"
    },
    "rl.ask.odd": {
      "text": "Three of these rhyme. Which one does not? Listen!"
    },
    "rl.ask.chain": {
      "text": "Find every picture that rhymes, and hang it on the string!"
    },
    "rl.yes": {
      "text": "Yes, they rhyme!"
    },
    "rl.no": {
      "text": "No, they don't rhyme."
    },
    "rl.slot": {
      "text": "Pick a picture lantern to hang here."
    },
    "rl.basket": {
      "text": "Pick the lantern that does not rhyme, and put it here."
    },
    "rl.idle": {
      "text": "Tap a lantern to hear its word."
    },
    "rl.help.explain": {
      "text": "Rhyming words sound the same at the end, like moon and spoon!"
    },
    "rl.help.hint": {
      "text": "Say them slowly, and listen to the very end of each word."
    },
    "rl.hint.model": {
      "text": "Let's listen slowly, all the way to the end."
    },
    "rl.hint.try": {
      "text": "Now it's your turn. Try the shining one!"
    },
    "rl.retry": {
      "text": "Hmm, let's listen to the ends again."
    },
    "rl.praise.1": {
      "text": "You listened all the way to the end!"
    },
    "rl.praise.2": {
      "text": "Careful listening! The lanterns are glowing."
    },
    "rl.praise.3": {
      "text": "You heard the endings. Glow, glow, glow!"
    },
    "rl.praise.4": {
      "text": "Your ears did the work. Lovely listening!"
    },
