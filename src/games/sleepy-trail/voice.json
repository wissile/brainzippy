    "st.hint.jumps": {
      "text": "Count the jumps, not the posts. Zero is where we start."
    },
    "st.hint.parts": {
      "text": "The bottom number tells how many equal parts make one whole trail."
    },
    "st.hint.topbottom": {
      "text": "The top number says how many jumps. The bottom says how big each jump is."
    },
    "st.hint.bigger": {
      "text": "More parts means each part is smaller."
