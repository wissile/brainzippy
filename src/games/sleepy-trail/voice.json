  "lines": {
    "st.story.1": {
      "text": "Rumble loves naps. Big, long, cozy naps."
    },
    "st.story.2": {
      "text": "His map shows nap spots on the Sleepy Trail, from Mossy Rock to Big Tree."
    },
    "st.story.3": {
      "text": "But the spots are fractions of the trail! One half, one third…"
    },
    "st.story.4": {
      "text": "Help Rumble put a pillow on every nap spot."
    },
    "st.story.mid1": {
      "text": "Two pillows down. Rumble yawns."
    },
    "st.story.mid2": {
      "text": "Halfway through the pillows!"
    },
    "st.story.mid3": {
      "text": "The sun is setting. Two more spots!"
    },
    "st.story.end1": {
      "text": "Every pillow is on its spot."
    },
    "st.story.end2": {
      "text": "You counted equal jumps from zero. That's how fractions work!"
    },
    "st.story.end3": {
      "text": "Rumble is snoring. Here's your Trail Marker!"
    },
    "st.intro": {
      "text": "Rumble is sleepy. Will you help him find his nap spots?"
    },
    "st.back": {
      "text": "Welcome back! Rumble has more nap spots to find."
    },
    "st.help.start": {
      "text": "A fraction is a spot on the trail. Split the trail into equal parts first."
    },
    "st.help.bottom": {
      "text": "The bottom number: how many equal parts in one whole."
    },
    "st.help.top": {
      "text": "The top number: how many parts we walk from zero."
    },
    "st.help.beyond": {
      "text": "After Big Tree, the trail keeps going. Four fourths is one whole!"
    },
    "st.help.same": {
      "text": "One half and four eighths land on the very same spot."
    },
    "st.help.compare": {
      "text": "Walk both trails. Whoever is closer to Big Tree walked farther."
    },
    "st.help.estimate": {
      "text": "No posts now. Find one half first, then guess the rest."
    },
